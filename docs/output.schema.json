{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "env-contract-check report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checked", "issues"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["valid", "invalid", "error"]},
    "checked": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "variable", "line"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z]+\\.[a-z_]+$"},
          "message": {"type": "string", "minLength": 1},
          "variable": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "line": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "valid"}}},
     "then": {"properties": {"issues": {"maxItems": 0}}},
     "else": {"properties": {"issues": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "error"}}},
     "then": {"properties": {"checked": {"const": 0}}}}
  ]
}
